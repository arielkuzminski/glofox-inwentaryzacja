{
  "name": "glofox-inwentaryzacja",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Panel do przeprowadzania i zarządzania inwentaryzacją sklepu Glofox (loss prevention, bez backendu).",
  "scripts": {
    "bookmarklet": "node scripts/build-bookmarklet.mjs",
    "dev": "npm run bookmarklet && vite",
    "build": "npm run bookmarklet && tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run bookmarklet && vitest run",
    "test:watch": "npm run bookmarklet && vitest",
    "typecheck": "npm run bookmarklet && tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^24.1.3",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
